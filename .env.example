# API base URL (without trailing slash).
# Dev: leave empty — Vite proxy forwards /api to localhost:8080 (psych-bot monolith)
# Prod with nginx on :4205 proxying /api → 8080: leave empty (same-origin)
VITE_API_URL=

# Login credentials (frontend check; replace on production)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=changeme
